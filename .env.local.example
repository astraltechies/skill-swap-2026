# Copy to .env.local and fill in. Never commit .env.local.
# On Netlify these same names go in Site settings > Environment variables.

# ---------------------------------------------------------------------------
# Firebase client config (Project settings > General > Your apps > Web app)
# These ship to the browser by design. They are not secrets — the protection
# comes from firestore.rules, not from hiding these.
# ---------------------------------------------------------------------------
# No STORAGE_BUCKET here on purpose — Firebase Storage now needs the paid
# Blaze plan even within its free quota, so this app doesn't use it. Avatars
# fall back to initials, or to the photo already on a Google account.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin (Project settings > Service accounts > Generate new private key)
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
# Paste the private key on one line, keeping the \n escapes exactly as they
# appear in the downloaded JSON, wrapped in double quotes.
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# SkillBot providers. Tried in the order listed in AI_PROVIDER_ORDER; the first
# one that answers within the timeout wins. All three have free tiers.
#   Gemini  https://aistudio.google.com/apikey
#   Groq    https://console.groq.com/keys
#   Mistral https://console.mistral.ai/api-keys
# Missing keys are skipped automatically, so the app runs with one, two or all
# three configured.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
AI_PROVIDER_ORDER=gemini,groq,mistral
CHATBOT_RATE_LIMIT_PER_HOUR=20

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
