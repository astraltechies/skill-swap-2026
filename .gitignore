# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every real one stays out of the repo
.env*
# ...except the blank template, which the README tells you to copy. It was
# being swallowed by the rule above, so a fresh clone had no way to know which
# variables the app needs.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Ad-hoc one-off scripts run from the project root
/watch-admin.mts
/chk.mts
/whois.mts
/idxcheck.mts
/cjs-smoke.cjs
